# Copy to .env and fill with real values. Do not commit .env.

# Modal service-user credentials. Stored into noto's credential store by
# `make model-setup`; the app does not require the Modal CLI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Generated Modal Web Function URL for the user's deployed compute endpoint.
# Free-plan Modal deployments use modal.run URLs, not custom domains.
NOTO_MODAL_ENDPOINT_URL=

# Optional bearer token enforced by the deployed compute endpoint. If empty,
# `noto modal setup` generates and stores one locally for the remote route.
NOTO_MODAL_ENDPOINT_TOKEN=

# Modal deployment metadata.
NOTO_MODAL_APP_NAME=noto-compute
NOTO_MODAL_ENVIRONMENT=main
NOTO_MODAL_GPU=L4

# Transfer modes:
#   http      = Web Function request body (simple; best for small files)
#   temporary = modal.Volume.ephemeral() staging (best for large user files)
#   permanent = named modal.Volume (benchmarks/model cache only)
NOTO_MODAL_USER_TRANSFER_MODE=http
NOTO_MODAL_BENCHMARK_TRANSFER_MODE=permanent
NOTO_MODAL_TEMPORARY_THRESHOLD_MB=128

# Runtime/cache knobs:
#   volume = persistent Modal Volume cache for model weights (default)
#   image  = bake weights into the deployed image when we want larger images but
#            no model-volume read during cold start
NOTO_MODAL_MODEL_CACHE=volume
NOTO_MODAL_SCALEDOWN_WINDOW_SECONDS=300
NOTO_MODAL_MIN_CONTAINERS=0
