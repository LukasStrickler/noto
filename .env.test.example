# Copy to .env.test for benchmark/dev runs with real credentials.

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
NOTO_MODAL_ENDPOINT_URL=
NOTO_MODAL_ENDPOINT_TOKEN=

NOTO_MODAL_APP_NAME=noto-compute-dev
NOTO_MODAL_ENVIRONMENT=dev
NOTO_MODAL_GPU=L4

# Benchmark data is allowed to persist separately from user recordings.
NOTO_MODAL_MODEL_VOLUME=noto-model-cache-dev
NOTO_MODAL_BENCHMARK_VOLUME=noto-benchmark-cache-dev
NOTO_MODAL_USER_TRANSFER_MODE=http
NOTO_MODAL_BENCHMARK_TRANSFER_MODE=permanent
NOTO_MODAL_TEMPORARY_THRESHOLD_MB=128
NOTO_MODAL_MODEL_CACHE=volume
NOTO_MODAL_SCALEDOWN_WINDOW_SECONDS=120
NOTO_MODAL_MIN_CONTAINERS=0

BENCH_HOURS=0.5
BENCH_FORMAT=json
